{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Isshin Player",
  "version": "1.0.12",
  "identifier": "com.projectplayer.app",
  "build": {
    "beforeDevCommand": "yarn --cwd frontend dev --host 127.0.0.1 --port 5173",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "yarn --cwd frontend build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Isshin Player",
        "width": 1280,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Entertainment",
    "shortDescription": "Local multimodal streaming player",
    "longDescription": "A multi-modal streaming player for local resources"
  }
}
